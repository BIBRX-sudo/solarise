# Solarise Odisha Environment Configuration Template
# Copy this file to .env on your server and populate with secure values.
# Do NOT commit production .env to version control.

# Admin API Key for dashboard authentication (generate with: openssl rand -hex 24)
ADMIN_API_KEY=

# Webhook Secret for validating OpenWA incoming payloads (generate with: openssl rand -hex 24)
WEBHOOK_SECRET=

# Secret key for JWT token signing (generate with: openssl rand -hex 32)
JWT_SECRET=

# OpenWA API Key (matches the API_MASTER_KEY configured in OpenWA container)
OPENWA_API_KEY=

# OpenWA Session Identifier (UUID format)
OPENWA_SESSION_ID=b9290ec0-2954-4be2-a32d-111512c06f7e

# OpenWA Base URL (in Docker Compose network: http://openwa-api:2785; local: http://127.0.0.1:2785)
OPENWA_URL=http://openwa-api:2785

# OpenWA Image Reference (defaults to local build 'openwa-openwa' or custom registry image)
# OPENWA_IMAGE=openwa-openwa

# Optional Dedicated Business WhatsApp Number (e.g. +91XXXXXXXXXX)
BUSINESS_NUMBER=

# Allowed CORS origins for dashboard API calls (e.g. https://solarise.yourcompany.com)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8009

# Optional SQLite database path (defaults to solarise_leads.db)
# LEADS_DB_PATH=solarise_leads.db

# Groq AI Configuration
# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=
# Groq model (e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile
# Optional local daily request budget safeguard (default: 100 requests/day; 0 or negative = unlimited)
GROQ_DAILY_LIMIT=100
# Optional Groq API request timeout in seconds (default: 15)
GROQ_TIMEOUT=15.0
