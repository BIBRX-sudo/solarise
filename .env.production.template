# Solarise Odisha — Production Environment Configuration Template
# Copy this file to .env on your VPS and populate the values.
# NEVER commit production .env with populated secrets to Git.

# --- Domain & TLS Configuration ---
# Your public fully qualified domain name pointing to your VPS IP (e.g. solarise.yourdomain.com)
DOMAIN=
# Your email address for Let's Encrypt / ZeroSSL TLS certificate notifications
ACME_EMAIL=

# --- Authentication & Secrets ---
# Admin API Key for accessing the web dashboard (copy from existing local .env)
ADMIN_API_KEY=
# Secret key for JWT session tokens (copy from existing local .env)
JWT_SECRET=
# Webhook secret for OpenWA payload verification (copy from existing local .env)
WEBHOOK_SECRET=
# Master API Key for OpenWA API (copy from existing local .env)
OPENWA_API_KEY=

# --- OpenWA Session Settings ---
OPENWA_SESSION_ID=b9290ec0-2954-4be2-a32d-111512c06f7e
OPENWA_IMAGE=openwa-openwa

# --- WhatsApp Numbers & Testing ---
# Optional dedicated business WhatsApp number (e.g. +91XXXXXXXXXX)
BUSINESS_NUMBER=
# Inbound testing allowlist: LEAVE EMPTY to keep fail-closed (personal chats ignored)
# When testing with a specific number, set to: 91XXXXXXXXXX (NEVER use '*')
ALLOWED_TEST_PHONE=
